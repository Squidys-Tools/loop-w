<UserControl x:Class="LoopW.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:LoopW"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="Window_Loaded">
    <Grid Margin="16" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:NavigationView x:Name="NavigationMenu"
                           Grid.Column="0"
                           Width="244"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Stretch"
                           Panel.ZIndex="2"
                           PaneDisplayMode="Left"
                           IsPaneVisible="True"
                           IsPaneOpen="True"
                           IsPaneToggleVisible="False"
                           IsBackButtonVisible="Collapsed"
                           IsTopSeparatorVisible="False"
                           IsFooterSeparatorVisible="False"
                           OpenPaneLength="244"
                           CompactPaneLength="244"
                           FrameMargin="0"
                           Background="{DynamicResource ApplicationBackgroundBrush}"
                           BorderBrush="Transparent"
                           BorderThickness="0"
                           SelectionChanged="SectionNav_SelectionChanged">
            <ui:NavigationView.PaneHeader>
                <TextBlock Text="Settings"
                           Margin="16,18,16,20"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="BehaviorNavigationItem"
                                       Content="General"
                                       Tag="Behavior"
                                       Click="SectionNavItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="RadialNavigationItem"
                                       Content="Radial menu"
                                       Tag="Radial"
                                       Click="SectionNavItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="CircleMultipleConcentric16" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="PreviewNavigationItem"
                                       Content="Preview"
                                       Tag="Preview"
                                       Click="SectionNavItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Eye24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="AppearanceNavigationItem"
                                       Content="Appearance"
                                       Tag="Appearance"
                                       Click="SectionNavItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Color24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="AdvancedNavigationItem"
                                       Content="Advanced"
                                       Tag="Advanced"
                                       Click="SectionNavItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.PaneFooter>
                <TextBlock Text="Changes save automatically"
                           Margin="16,16,16,12"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>

        <Grid Grid.Column="1" Margin="28,24,24,18" Panel.ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ContentScroller"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,12,8">
                <Grid>
                    <StackPanel x:Name="BehaviorSection">
                        <DockPanel Margin="0,0,0,14">
                            <ui:Button Content="Reset section"
                                       Tag="Behavior"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       Click="ResetSection_Click" />
                            <TextBlock Text="Set the gesture that brings LoopW into the flow, then decide how quietly it starts."
                                       MaxWidth="500"
                                       HorizontalAlignment="Left"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Trigger key" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Hold this key while choosing a window action. Esc cancels capture without changing it."
                                               MaxWidth="330"
                                               HorizontalAlignment="Left"
                                               Margin="0,4,20,0"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="CaptureHint"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:Button x:Name="TriggerLabel"
                                               Content="Tab"
                                               Appearance="Secondary"
                                               Margin="0,0,8,0"
                                               AutomationProperties.Name="Current trigger key"
                                               Click="Trigger_Click" />
                                    <ui:Button x:Name="TriggerButton"
                                               Content="Rebind"
                                               Icon="{ui:SymbolIcon Symbol=Edit24}"
                                               Appearance="Primary"
                                               AutomationProperties.Name="Rebind trigger key"
                                               Click="Trigger_Click" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Trigger behavior" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Tune how LoopW recognizes and holds the trigger."
                                           Margin="0,4,0,14"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Require a double-click" FontSize="13" />
                                        <TextBlock Text="Activate only after the trigger is pressed twice."
                                                   Margin="0,3,14,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="DoubleClickTriggerCheck"
                                                     Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     Checked="TriggerBehavior_Changed"
                                                     Unchecked="TriggerBehavior_Changed"
                                                     AutomationProperties.Name="Require a double-click to activate" />
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                        <TextBlock Text="Middle mouse button" FontSize="13" />
                                        <TextBlock Text="Allow the middle button to hold the radial menu open."
                                                   Margin="0,3,14,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="MiddleClickTriggerCheck"
                                                     Grid.Row="1"
                                                     Grid.Column="1"
                                                     VerticalAlignment="Center"
                                                     Margin="0,16,0,0"
                                                     Checked="TriggerBehavior_Changed"
                                                     Unchecked="TriggerBehavior_Changed"
                                                     AutomationProperties.Name="Allow middle mouse button to activate" />
                                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                        <TextBlock Text="Modifier side" FontSize="13" />
                                        <TextBlock Text="Use either side, or require the left/right modifier."
                                                   Margin="0,3,14,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="TriggerSideCombo"
                                              Grid.Row="2"
                                              Grid.Column="1"
                                              Width="150"
                                              VerticalAlignment="Center"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="TriggerSide_SelectionChanged"
                                              AutomationProperties.Name="Trigger modifier side">
                                        <ComboBoxItem Content="Either side" Tag="Any" />
                                        <ComboBoxItem Content="Left side" Tag="Left" />
                                        <ComboBoxItem Content="Right side" Tag="Right" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Activation delay" FontSize="13" />
                                    <TextBlock x:Name="TriggerDelayValue"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="TriggerDelaySlider"
                                        Minimum="0"
                                        Maximum="1000"
                                        TickFrequency="50"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="TriggerBehavior_ValueChanged"
                                        AutomationProperties.Name="Activation delay" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Activation timeout" FontSize="13" />
                                    <TextBlock x:Name="TriggerTimeoutValue"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="TriggerTimeoutSlider"
                                        Minimum="0"
                                        Maximum="10000"
                                        TickFrequency="500"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="TriggerBehavior_ValueChanged"
                                        AutomationProperties.Name="Activation timeout" />
                                <TextBlock Text="Set timeout to Off to let the trigger remain active until release."
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Launch at sign-in" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="LoopW starts quietly in the tray and is ready when you need it."
                                               MaxWidth="300"
                                               HorizontalAlignment="Left"
                                               Margin="0,4,20,0"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="LaunchAtLoginCheck"
                                                 Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Content="Start with Windows"
                                                 Checked="Behavior_Changed"
                                                 Unchecked="Behavior_Changed"
                                                 AutomationProperties.Name="Launch LoopW at sign-in" />
                            </Grid>
                        </ui:Card>
                    </StackPanel>

                    <StackPanel x:Name="RadialSection" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,14">
                            <ui:Button Content="Reset section"
                                       Tag="Radial"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       Click="ResetSection_Click" />
                            <TextBlock Text="Shape the ring that appears around your cursor without losing its visual rhythm."
                                       MaxWidth="500"
                                       HorizontalAlignment="Left"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>

                        <ui:Card Padding="0"
                                 Height="260"
                                 Margin="0,0,0,16"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
                            <Viewbox Stretch="Uniform">
                                <local:RadialMenuSurface x:Name="SettingsRadialSurface"
                                                         IsPointerSelectionEnabled="True" />
                            </Viewbox>
                        </ui:Card>

                        <Grid>
                            <StackPanel>
                                <ui:Card Padding="20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Interaction" FontSize="15" FontWeight="SemiBold" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Show the radial menu" FontSize="13" />
                                                <TextBlock Text="Open it while the trigger is held."
                                                           Margin="0,3,14,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ui:ToggleSwitch x:Name="RadialEnabledCheck"
                                                             Grid.Column="1"
                                                             VerticalAlignment="Center"
                                                             Checked="Radial_Changed"
                                                             Unchecked="Radial_Changed"
                                                             AutomationProperties.Name="Show the radial menu" />
                                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                                <TextBlock Text="Cursor direction selects" FontSize="13" />
                                                <TextBlock Text="Move toward a wedge to preview its action."
                                                           Margin="0,3,14,0"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ui:ToggleSwitch x:Name="CursorInteractionCheck"
                                                             Grid.Row="1"
                                                             Grid.Column="1"
                                                             VerticalAlignment="Center"
                                                             Checked="Radial_Changed"
                                                             Unchecked="Radial_Changed"
                                                             AutomationProperties.Name="Cursor direction selects" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Ring geometry" FontSize="15" FontWeight="SemiBold" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Outer radius" FontSize="13" VerticalAlignment="Center" />
                                            <ui:NumberBox x:Name="OuterRadiusInput"
                                                          Grid.Column="1"
                                                          Width="90"
                                                          Minimum="64"
                                                          Maximum="140"
                                                          SmallChange="1"
                                                          LargeChange="8"
                                                          SpinButtonPlacementMode="Compact"
                                                          ValueChanged="RadialNumber_ValueChanged"
                                                          AutomationProperties.Name="Outer radius" />
                                            <Slider x:Name="OuterRadiusSlider"
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Minimum="64"
                                                    Maximum="140"
                                                    TickFrequency="4"
                                                    IsSnapToTickEnabled="False"
                                                    ValueChanged="Radial_ValueChanged"
                                                    AutomationProperties.Name="Outer radius slider" />
                                            <TextBlock Text="Inner radius" Grid.Row="2" FontSize="13" VerticalAlignment="Center" Margin="0,12,0,0" />
                                            <ui:NumberBox x:Name="InnerRadiusInput"
                                                          Grid.Row="2"
                                                          Grid.Column="1"
                                                          Width="90"
                                                          Minimum="24"
                                                          Maximum="132"
                                                          SmallChange="1"
                                                          LargeChange="8"
                                                          Margin="0,12,0,0"
                                                          SpinButtonPlacementMode="Compact"
                                                          ValueChanged="RadialNumber_ValueChanged"
                                                          AutomationProperties.Name="Inner radius" />
                                            <Slider x:Name="InnerRadiusSlider"
                                                    Grid.Row="3"
                                                    Grid.ColumnSpan="2"
                                                    Minimum="24"
                                                    Maximum="132"
                                                    TickFrequency="4"
                                                    IsSnapToTickEnabled="False"
                                                    ValueChanged="Radial_ValueChanged"
                                                    AutomationProperties.Name="Inner radius slider" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Padding="20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Wedge assignments" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Choose what each direction commits. Keybind entries follow the bindings in Advanced."
                                                   Margin="0,4,0,14"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl x:Name="RadialSlotList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="105" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding Choices}"
                                                                  DisplayMemberPath="Display"
                                                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                                  SelectionChanged="RadialSlot_SelectionChanged"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Radial wedge assignment" />
                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="12,0,0,0">
                                                            <TextBlock Text="Cycle" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <ui:ToggleSwitch IsChecked="{Binding CycleEnabled}"
                                                                             IsEnabled="{Binding CanCycle}"
                                                                             Checked="RadialSlotCycle_Changed"
                                                                             Unchecked="RadialSlotCycle_Changed"
                                                                             AutomationProperties.Name="Cycle radial wedge action" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Padding="20" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Center action" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="The center is selected when the cursor rests inside the ring."
                                                       Margin="0,4,20,0"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ComboBox x:Name="CenterActionCombo"
                                                  Grid.Column="1"
                                                  DisplayMemberPath="Display"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="CenterAction_SelectionChanged"
                                                  AutomationProperties.Name="Radial center action" />
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                            <TextBlock Text="Cycle" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:ToggleSwitch x:Name="CenterCycleCheck"
                                                             IsEnabled="False"
                                                             Checked="CenterCycle_Changed"
                                                             Unchecked="CenterCycle_Changed"
                                                             AutomationProperties.Name="Cycle radial center action" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PreviewSection" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,14">
                            <ui:Button Content="Reset section"
                                       Tag="Preview"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       Click="ResetSection_Click" />
                            <TextBlock Text="Tune the window target that appears before an action is committed."
                                       MaxWidth="500"
                                       HorizontalAlignment="Left"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>

                        <ui:Card Padding="0"
                                 Height="420"
                                 Margin="0,0,0,16"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
                            <Viewbox Stretch="Uniform">
                                <local:WindowPreviewSurface x:Name="SettingsPreviewSurface"
                                                            Width="640"
                                                            Height="360"
                                                            Opacity="1" />
                            </Viewbox>
                        </ui:Card>

                        <Grid>
                            <ui:Card Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Preview settings" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Control when the target appears and tune its geometry."
                                               MaxWidth="360"
                                               HorizontalAlignment="Left"
                                               Margin="0,4,0,16"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:ToggleSwitch x:Name="PreviewEnabledCheck"
                                                     Content="Show the target preview"
                                                     Checked="Preview_Changed"
                                                     Unchecked="Preview_Changed"
                                                     AutomationProperties.Name="Show the target preview" />
                                    <Grid Margin="0,22,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Padding" FontSize="13" VerticalAlignment="Center" />
                                        <ui:NumberBox x:Name="PreviewPaddingInput"
                                                      Grid.Column="1"
                                                      Width="90"
                                                      Minimum="4"
                                                      Maximum="48"
                                                      SmallChange="1"
                                                      LargeChange="4"
                                                      SpinButtonPlacementMode="Compact"
                                                      ValueChanged="PreviewNumber_ValueChanged"
                                                      AutomationProperties.Name="Preview padding" />
                                        <Slider x:Name="PreviewPaddingSlider"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Minimum="4"
                                                Maximum="48"
                                                ValueChanged="Preview_ValueChanged"
                                                AutomationProperties.Name="Preview padding slider" />
                                        <TextBlock Text="Corner radius" Grid.Row="2" FontSize="13" VerticalAlignment="Center" Margin="0,12,0,0" />
                                        <ui:NumberBox x:Name="PreviewCornerInput"
                                                      Grid.Row="2"
                                                      Grid.Column="1"
                                                      Width="90"
                                                      Minimum="4"
                                                      Maximum="32"
                                                      SmallChange="1"
                                                      LargeChange="4"
                                                      Margin="0,12,0,0"
                                                      SpinButtonPlacementMode="Compact"
                                                      ValueChanged="PreviewNumber_ValueChanged"
                                                      AutomationProperties.Name="Preview corner radius" />
                                        <Slider x:Name="PreviewCornerSlider"
                                                Grid.Row="3"
                                                Grid.ColumnSpan="2"
                                                Minimum="4"
                                                Maximum="32"
                                                ValueChanged="Preview_ValueChanged"
                                                AutomationProperties.Name="Preview corner radius slider" />
                                        <TextBlock Text="Border width" Grid.Row="4" FontSize="13" VerticalAlignment="Center" Margin="0,12,0,0" />
                                        <ui:NumberBox x:Name="PreviewBorderWidthInput"
                                                      Grid.Row="4"
                                                      Grid.Column="1"
                                                      Width="90"
                                                      Minimum="0"
                                                      Maximum="6"
                                                      SmallChange="1"
                                                      LargeChange="2"
                                                      Margin="0,12,0,0"
                                                      SpinButtonPlacementMode="Compact"
                                                      ValueChanged="PreviewNumber_ValueChanged"
                                                      AutomationProperties.Name="Preview border width" />
                                        <Slider x:Name="PreviewBorderWidthSlider"
                                                Grid.Row="5"
                                                Grid.ColumnSpan="2"
                                                Minimum="0"
                                                Maximum="6"
                                                ValueChanged="Preview_ValueChanged"
                                                AutomationProperties.Name="Preview border width slider" />
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                        </Grid>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Drag snapping" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Preview and commit a half or quarter zone when a title-bar drag reaches a monitor edge."
                                           MaxWidth="460"
                                           Margin="0,4,0,14"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:ToggleSwitch x:Name="DragSnapEnabledCheck"
                                                 Content="Snap dragged windows to edges and corners"
                                                 Checked="DragSnap_Changed"
                                                 Unchecked="DragSnap_Changed"
                                                 AutomationProperties.Name="Enable drag snapping" />
                                <ui:ToggleSwitch x:Name="RestorePreDragFrameCheck"
                                                 Content="Restore the original frame when a snap is canceled"
                                                 Margin="0,12,0,0"
                                                 Checked="DragSnap_Changed"
                                                 Unchecked="DragSnap_Changed"
                                                 AutomationProperties.Name="Restore the frame when snap is canceled" />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Snap threshold" FontSize="13" />
                                    <TextBlock x:Name="DragSnapThresholdValue"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="DragSnapThresholdSlider"
                                        Minimum="4"
                                        Maximum="96"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="DragSnap_ValueChanged"
                                        AutomationProperties.Name="Drag snap threshold" />
                                <TextBlock Text="The threshold is measured from the physical monitor edge, so taskbars do not make a zone harder to reach."
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Stash and reveal" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Keep windows safely identifiable across a LoopW restart and tune how much of a stashed window remains reachable."
                                           MaxWidth="460"
                                           Margin="0,4,0,14"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:ToggleSwitch x:Name="StashPersistenceCheck"
                                                 Content="Persist stashed windows across restart"
                                                 Checked="Stash_Changed"
                                                 Unchecked="Stash_Changed"
                                                 AutomationProperties.Name="Persist stashed windows" />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Edge peek" FontSize="13" />
                                    <TextBlock x:Name="StashEdgePeekValue"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="StashEdgePeekSlider"
                                        Minimum="1"
                                        Maximum="48"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Stash_ValueChanged"
                                        AutomationProperties.Name="Stash edge peek" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Reveal hit zone" FontSize="13" />
                                    <TextBlock x:Name="StashHitZoneValue"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="StashHitZoneSlider"
                                        Minimum="1"
                                        Maximum="96"
                                        TickFrequency="2"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Stash_ValueChanged"
                                        AutomationProperties.Name="Stash reveal hit zone" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Reveal delay" FontSize="13" />
                                    <TextBlock x:Name="StashRevealDelayValue"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="StashRevealDelaySlider"
                                        Minimum="0"
                                        Maximum="500"
                                        TickFrequency="20"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Stash_ValueChanged"
                                        AutomationProperties.Name="Stash reveal delay" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,14">
                            <ui:Button Content="Reset section"
                                       Tag="Appearance"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       Click="ResetSection_Click" />
                            <TextBlock Text="Use the WPF UI theme as the foundation, then choose the LoopW accent and preview treatment."
                                       MaxWidth="500"
                                       HorizontalAlignment="Left"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="App appearance" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Dark, light, or follow the Windows appearance setting."
                                               MaxWidth="280"
                                               HorizontalAlignment="Left"
                                               Margin="0,4,20,0"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="AppearanceModeCombo"
                                          Grid.Column="1"
                                          Width="176"
                                          VerticalAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="AppearanceMode_SelectionChanged"
                                          AutomationProperties.Name="App appearance mode">
                                    <ComboBoxItem Content="LoopW dark" Tag="Dark" />
                                    <ComboBoxItem Content="Follow Windows" Tag="FollowWindows" />
                                    <ComboBoxItem Content="LoopW light" Tag="Light" />
                                </ComboBox>
                            </Grid>
                        </ui:Card>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Curated visual styles" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Choose a complete LoopW accent set. The controls themselves stay WPF UI Fluent."
                                           Margin="0,4,0,14"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <UniformGrid Columns="3">
                                    <ui:Button x:Name="BluePresetButton"
                                               Tag="LoopWBlue"
                                               Appearance="Secondary"
                                               Margin="0,0,8,0"
                                               Click="Preset_Click"
                                               AutomationProperties.Name="Apply LoopW blue style">
                                        <StackPanel>
                                            <Ellipse Width="14" Height="14" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Left" />
                                            <TextBlock Text="LoopW blue" Margin="0,8,0,0" FontWeight="SemiBold" />
                                            <TextBlock Text="Focused and familiar" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button x:Name="CobaltPresetButton"
                                               Tag="Cobalt"
                                               Appearance="Secondary"
                                               Margin="0,0,8,0"
                                               Click="Preset_Click"
                                               AutomationProperties.Name="Apply cobalt style">
                                        <StackPanel>
                                            <Ellipse Width="14" Height="14" Fill="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Left" />
                                            <TextBlock Text="Cobalt" Margin="0,8,0,0" FontWeight="SemiBold" />
                                            <TextBlock Text="Bright and crisp" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button x:Name="VioletPresetButton"
                                               Tag="Violet"
                                               Appearance="Secondary"
                                               Click="Preset_Click"
                                               AutomationProperties.Name="Apply violet style">
                                        <StackPanel>
                                            <Ellipse Width="14" Height="14" Fill="{DynamicResource SystemAccentColorTertiaryBrush}" HorizontalAlignment="Left" />
                                            <TextBlock Text="Violet" Margin="0,8,0,0" FontWeight="SemiBold" />
                                            <TextBlock Text="Soft and expressive" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </ui:Button>
                                </UniformGrid>
                            </StackPanel>
                        </ui:Card>

                        <ui:CardExpander x:Name="CustomThemeExpander"
                                         Header="Custom colors"
                                         Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="These values are kept for overlay and preview compatibility."
                                           Margin="0,0,0,14"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Accent" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <Border x:Name="AccentSwatch" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Margin="0,0,8,10" />
                                    <ui:TextBox x:Name="AccentColorText" Grid.Column="2" Margin="0,0,0,10" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" AutomationProperties.Name="Accent color" />
                                    <TextBlock Text="Sector fill" Grid.Row="1" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <Border x:Name="SectorFillSwatch" Grid.Row="1" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Margin="0,0,8,10" />
                                    <ui:TextBox x:Name="SectorFillText" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" AutomationProperties.Name="Radial sector fill" />
                                    <TextBlock Text="Sector stroke" Grid.Row="2" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <Border x:Name="SectorStrokeSwatch" Grid.Row="2" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Margin="0,0,8,10" />
                                    <ui:TextBox x:Name="SectorStrokeText" Grid.Row="2" Grid.Column="2" Margin="0,0,0,10" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" AutomationProperties.Name="Radial sector stroke" />
                                    <TextBlock Text="Ring fill" Grid.Row="3" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <Border x:Name="RingFillSwatch" Grid.Row="3" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Margin="0,0,8,10" />
                                    <ui:TextBox x:Name="RingFillText" Grid.Row="3" Grid.Column="2" Margin="0,0,0,10" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" AutomationProperties.Name="Radial ring fill" />
                                    <TextBlock Text="Preview border" Grid.Row="4" FontSize="13" VerticalAlignment="Center" />
                                    <Border x:Name="PreviewBorderSwatch" Grid.Row="4" Grid.Column="1" Width="16" Height="16" CornerRadius="8" />
                                    <ui:TextBox x:Name="PreviewBorderText" Grid.Row="4" Grid.Column="2" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" AutomationProperties.Name="Preview border color" />
                                </Grid>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>

                    <StackPanel x:Name="AdvancedSection" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,14">
                            <ui:Button Content="Reset section"
                                       Tag="Advanced"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       Click="ResetSection_Click" />
                            <TextBlock Text="Build direct keyboard paths and keep recovery tools close at hand."
                                       MaxWidth="500"
                                       HorizontalAlignment="Left"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Keybinds" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Hold the trigger, or let a binding run without it, to apply an action instantly."
                                           Margin="0,4,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="KeybindEmptyState"
                                           Text="No keybinds yet. Add one to build a direct keyboard path."
                                           Margin="0,16,0,4"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ItemsControl x:Name="KeybindList" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4"
                                                    Padding="10"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                    <ui:Button Content="{Binding Display}"
                                                               Appearance="Secondary"
                                                               Click="KeyChip_Click"
                                                               ToolTip="Click to rebind this key"
                                                               AutomationProperties.Name="Rebind keybind" />
                                                    <ComboBox Grid.Column="1"
                                                              Margin="12,0"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{x:Static local:SettingsWindow.ActionChoices}"
                                                              SelectedValuePath="Key"
                                                              DisplayMemberPath="Value"
                                                              SelectedValue="{Binding Keybind.Action}"
                                                              SelectionChanged="Action_SelectionChanged"
                                                              AutomationProperties.Name="Keybind action" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Cycle" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ui:ToggleSwitch IsChecked="{Binding Keybind.CycleEnabled}"
                                                                         IsEnabled="{Binding CanCycle}"
                                                                         Checked="Cycle_Changed"
                                                                         Unchecked="Cycle_Changed"
                                                                         ToolTip="Cycle through supported sizes"
                                                                         AutomationProperties.Name="Cycle keybind action" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="Bypass" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <ui:ToggleSwitch IsChecked="{Binding Keybind.BypassTrigger}"
                                                                             Checked="Bypass_Changed"
                                                                             Unchecked="Bypass_Changed"
                                                                             ToolTip="Run this action without holding the trigger"
                                                                             AutomationProperties.Name="Run keybind without trigger" />
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="4"
                                                               Content="Delete"
                                                               Icon="{ui:SymbolIcon Symbol=Delete24}"
                                                               Appearance="Danger"
                                                               Click="Delete_Click"
                                                               ToolTip="Delete this keybind"
                                                               AutomationProperties.Name="Delete this keybind" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button x:Name="AddButton"
                                           Content="Add keybind"
                                           Icon="{ui:SymbolIcon Symbol=Add24}"
                                           Appearance="Primary"
                                           HorizontalAlignment="Left"
                                           Margin="0,14,0,0"
                                           Click="Add_Click"
                                           AutomationProperties.Name="Add keybind" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Window policy" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Control monitor sizing, screen margins, and which applications LoopW should leave alone."
                                           MaxWidth="460"
                                           Margin="0,4,0,14"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Moving between monitors" FontSize="13" />
                                        <TextBlock Text="Preserve physical pixels or logical size when moving a window between displays."
                                                   Margin="0,3,14,0"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="MonitorMovePolicyCombo"
                                              Grid.Column="1"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="MonitorMovePolicy_SelectionChanged"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Monitor move sizing policy">
                                        <ComboBoxItem Content="Preserve pixel size" Tag="PreservePixels" />
                                        <ComboBoxItem Content="Preserve logical size" Tag="PreserveLogicalSize" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="Screen padding" FontSize="13" FontWeight="SemiBold" Margin="0,22,0,4" />
                                <TextBlock Text="Global padding is added to each edge, then the per-edge values are added."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Global" FontSize="13" />
                                    <TextBlock x:Name="GlobalScreenPaddingValue" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="GlobalScreenPaddingSlider" Minimum="0" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="ScreenPadding_ValueChanged" AutomationProperties.Name="Global screen padding" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Left" FontSize="13" />
                                    <TextBlock x:Name="ScreenPaddingLeftValue" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="ScreenPaddingLeftSlider" Minimum="0" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="ScreenPadding_ValueChanged" AutomationProperties.Name="Left screen padding" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Top" FontSize="13" />
                                    <TextBlock x:Name="ScreenPaddingTopValue" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="ScreenPaddingTopSlider" Minimum="0" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="ScreenPadding_ValueChanged" AutomationProperties.Name="Top screen padding" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Right" FontSize="13" />
                                    <TextBlock x:Name="ScreenPaddingRightValue" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="ScreenPaddingRightSlider" Minimum="0" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="ScreenPadding_ValueChanged" AutomationProperties.Name="Right screen padding" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bottom" FontSize="13" />
                                    <TextBlock x:Name="ScreenPaddingBottomValue" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="ScreenPaddingBottomSlider" Minimum="0" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="ScreenPadding_ValueChanged" AutomationProperties.Name="Bottom screen padding" />
                                <TextBlock Text="Excluded applications" FontSize="13" FontWeight="SemiBold" Margin="0,22,0,4" />
                                <TextBlock Text="One executable path or process name per line. Matching applications are ignored by window actions, snapping, stash, and IPC."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBox x:Name="ExcludedExecutablePathsText"
                                            MinHeight="72"
                                            Margin="0,10,0,0"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"
                                            LostFocus="Exclusions_LostFocus"
                                            AutomationProperties.Name="Excluded executable paths" />
                                <TextBlock Text="Process names" FontSize="13" Margin="0,14,0,4" />
                                <ui:TextBox x:Name="ExcludedProcessNamesText"
                                            MinHeight="56"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"
                                            LostFocus="Exclusions_LostFocus"
                                            AutomationProperties.Name="Excluded process names" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Reset all settings" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Restore defaults, remove custom keybinds, and return to the standard LoopW visual treatment. Tray state and open windows are not affected."
                                               MaxWidth="380"
                                               HorizontalAlignment="Left"
                                               Margin="0,4,18,0"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1"
                                           Content="Reset all"
                                           Appearance="Danger"
                                           VerticalAlignment="Center"
                                           Click="ResetAll_Click"
                                           AutomationProperties.Name="Reset all LoopW settings" />
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,10,12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon x:Name="StatusSuccessIcon"
                               Symbol="CheckmarkCircle16"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               Margin="0,0,7,0" />
                <ui:SymbolIcon x:Name="StatusErrorIcon"
                               Symbol="ErrorCircle16"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="Collapsed"
                               Margin="0,0,7,0" />
                <TextBlock x:Name="StatusText"
                           Text="Saved"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,12,8" />
                <ui:ContentDialogHost x:Name="ContentDialogHost"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              IsDisableSiblingsEnabled="True" />
                </Grid>
        </Grid>
</UserControl>
