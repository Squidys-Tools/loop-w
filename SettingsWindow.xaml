<Window x:Class="LoopW.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LoopW"
        Title="LoopW Settings"
        Height="520" Width="640"
        MinHeight="420" MinWidth="520"
        Background="#1E1E1E"
        Foreground="#CCCCCC"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
        <SolidColorBrush x:Key="MutedBrush" Color="#858585" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="CapBrush" Color="#333333" />
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Grid.Row="0" />

        <Grid Grid.Row="1" Margin="0,16,0,8">
            <StackPanel>
                <TextBlock Text="KEYBINDS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Hold the trigger, then press the bound key to apply an action instantly." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="KeybindList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12,10" Margin="0,4" BorderBrush="#3C3C3C" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#333333" CornerRadius="8" Padding="12,6" Cursor="Hand" ToolTip="Click to rebind the key">
                                    <TextBlock Text="{Binding Display}" FontSize="12" MouseLeftButtonUp="KeyChip_MouseLeftButtonUp" />
                                </Border>
                                <ComboBox Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                                          ItemsSource="{x:Static local:SettingsWindow.ActionChoices}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value"
                                          SelectedValue="{Binding Keybind.Action}"
                                          SelectionChanged="Action_SelectionChanged" />
                                <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0" Cursor="Hand" ToolTip="Delete" Click="Delete_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" Text=" " />

        <Button x:Name="AddButton" Grid.Row="4" Content="Add keybind" HorizontalAlignment="Left" Margin="0,8,0,0"
                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                Padding="16,8" Cursor="Hand" Click="Add_Click" />
    </Grid>
</Window>
