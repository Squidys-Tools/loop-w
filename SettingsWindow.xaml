<UserControl x:Class="LoopW.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LoopW"
             Background="{DynamicResource PageBrush}"
             Foreground="{DynamicResource PrimaryTextBrush}"
             Loaded="Window_Loaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#101216" />
        <SolidColorBrush x:Key="NavigationBrush" Color="#151922" />
        <SolidColorBrush x:Key="PanelBrush" Color="#191E27" />
        <SolidColorBrush x:Key="CardBrush" Color="#202632" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#293342" />
        <SolidColorBrush x:Key="InputBrush" Color="#151A22" />
        <SolidColorBrush x:Key="BorderBrush" Color="#303A48" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F0F4FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9DA9B9" />
        <SolidColorBrush x:Key="QuietTextBrush" Color="#6F7B8A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3D9BFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#263D9BFF" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#6AD5A0" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F1B86A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF8B91" />
        <SolidColorBrush x:Key="FocusBrush" Color="#78B9FF" />

        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionEyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavIndicator"
                                        Width="3"
                                        Height="20"
                                        CornerRadius="2"
                                        Background="Transparent"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="NavIndicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="NavChrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,5,0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track"
                                    Width="38"
                                    Height="22"
                                    Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb"
                                         Width="16"
                                         Height="16"
                                         Fill="{DynamicResource SecondaryTextBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="2"
                                         VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="KeyChipStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Grid.RowSpan="2"
                Background="{DynamicResource NavigationBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="4,4,4,26">
                    <TextBlock Text="LOOPW"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,0" />
                    <TextBlock Text="Settings"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0" />
                    <TextBlock Text="Make LoopW yours."
                               Style="{StaticResource DescriptionStyle}"
                               Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="SETTINGS"
                               Style="{StaticResource SectionEyebrowStyle}"
                               Margin="4,0,4,9" />
                    <RadioButton Content="Behavior"
                                 Tag="Behavior"
                                 GroupName="SettingsSections"
                                 IsChecked="True"
                                 Style="{StaticResource NavButtonStyle}"
                                 Checked="SectionNav_Checked" />
                    <RadioButton Content="Radial menu"
                                 Tag="Radial"
                                 GroupName="SettingsSections"
                                 Style="{StaticResource NavButtonStyle}"
                                 Checked="SectionNav_Checked" />
                    <RadioButton Content="Preview"
                                 Tag="Preview"
                                 GroupName="SettingsSections"
                                 Style="{StaticResource NavButtonStyle}"
                                 Checked="SectionNav_Checked" />
                    <RadioButton Content="Screens &amp; apps"
                                 Tag="Screens"
                                 GroupName="SettingsSections"
                                 Style="{StaticResource NavButtonStyle}"
                                 Checked="SectionNav_Checked" />
                    <RadioButton Content="Appearance"
                                 Tag="Appearance"
                                 GroupName="SettingsSections"
                                 Style="{StaticResource NavButtonStyle}"
                                 Checked="SectionNav_Checked" />
                    <RadioButton Content="Advanced"
                                 Tag="Advanced"
                                 GroupName="SettingsSections"
                                 Style="{StaticResource NavButtonStyle}"
                                 Checked="SectionNav_Checked" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="4,24,4,4">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,4,0,18">
                <StackPanel>
                    <TextBlock Text="Settings"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Tune how LoopW starts, feels, and responds."
                               Style="{StaticResource DescriptionStyle}"
                               Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Text="Changes save automatically"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           FontSize="11"
                           Foreground="{DynamicResource QuietTextBrush}" />
            </Grid>

            <ScrollViewer x:Name="ContentScroller"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="2,0,10,4">
                <Grid>
                    <StackPanel x:Name="BehaviorSection">
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Behavior" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Choose how LoopW starts and how you call it into the flow."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Content="Reset section"
                                    Tag="Behavior"
                                    Style="{StaticResource QuietButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Click="ResetSection_Click" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Trigger key" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Hold this key while choosing a window action."
                                               Style="{StaticResource DescriptionStyle}"
                                               Margin="0,4,0,0" />
                                    <TextBlock x:Name="CaptureHint"
                                               Text=""
                                               Style="{StaticResource DescriptionStyle}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,9,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="TriggerLabel"
                                            Content="Caps Lock"
                                            Style="{StaticResource KeyChipStyle}"
                                            Click="Trigger_Click"
                                            ToolTip="Click to rebind the trigger key" />
                                    <Button x:Name="TriggerButton"
                                            Content="Rebind"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Margin="8,0,0,0"
                                            Click="Trigger_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox x:Name="LaunchAtLoginCheck"
                                          Content="Launch LoopW when I sign in"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Checked="Behavior_Changed"
                                          Unchecked="Behavior_Changed" />
                                <TextBlock Text="LoopW starts quietly in the system tray and is ready when you need it."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="52,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Trigger behavior" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Tune how LoopW recognizes and holds the trigger."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,4,0,12" />
                                <CheckBox x:Name="DoubleClickTriggerCheck"
                                          Content="Require a double-click to activate"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Checked="TriggerBehavior_Changed"
                                          Unchecked="TriggerBehavior_Changed" />
                                <CheckBox x:Name="MiddleClickTriggerCheck"
                                          Content="Allow middle mouse button to activate"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Checked="TriggerBehavior_Changed"
                                          Unchecked="TriggerBehavior_Changed" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Modifier side" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="Use either side, or require the left/right modifier."
                                                   Style="{StaticResource DescriptionStyle}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ComboBox x:Name="TriggerSideCombo"
                                              Grid.Column="1"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="TriggerSide_SelectionChanged"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="Either side" Tag="Any" />
                                        <ComboBoxItem Content="Left side" Tag="Left" />
                                        <ComboBoxItem Content="Right side" Tag="Right" />
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Activation delay" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="TriggerDelayValue"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="TriggerDelaySlider"
                                        Minimum="0"
                                        Maximum="1000"
                                        TickFrequency="50"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="TriggerBehavior_ValueChanged" />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Activation timeout" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="TriggerTimeoutValue"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="TriggerTimeoutSlider"
                                        Minimum="0"
                                        Maximum="10000"
                                        TickFrequency="500"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="TriggerBehavior_ValueChanged" />
                                <TextBlock Text="A timeout closes an inactive radial menu without committing an action. Set it to Off to disable it."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0"
                                Visibility="Visible">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Keybinds" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Hold the trigger, or mark a keybind to run without it, to apply an action instantly."
                                               Style="{StaticResource DescriptionStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="KeybindEmptyState"
                                           Grid.Row="1"
                                           Text="No keybinds yet. Add one to build a direct keyboard path."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,16,0,4" />
                                <ItemsControl x:Name="KeybindList" Grid.Row="1" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InputBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="10,8"
                                                    Margin="0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="{Binding Display}"
                                                            Style="{StaticResource KeyChipStyle}"
                                                            Click="KeyChip_Click"
                                                            ToolTip="Click to rebind this key" />
                                                    <ComboBox Grid.Column="1"
                                                              Margin="12,0,12,0"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{x:Static local:SettingsWindow.ActionChoices}"
                                                              SelectedValuePath="Key"
                                                              DisplayMemberPath="Value"
                                                              SelectedValue="{Binding Keybind.Action}"
                                                              SelectionChanged="Action_SelectionChanged" />
                                                    <CheckBox Grid.Column="2"
                                                              Content="Cycle"
                                                              Style="{StaticResource ToggleCheckBoxStyle}"
                                                              IsChecked="{Binding Keybind.CycleEnabled}"
                                                              IsEnabled="{Binding CanCycle}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,12,0"
                                                              Checked="Cycle_Changed"
                                                              Unchecked="Cycle_Changed" />
                                                    <CheckBox Grid.Column="3"
                                                              Content="Bypass trigger"
                                                              Style="{StaticResource ToggleCheckBoxStyle}"
                                                              IsChecked="{Binding Keybind.BypassTrigger}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,12,0"
                                                              Checked="Bypass_Changed"
                                                              Unchecked="Bypass_Changed"
                                                              ToolTip="Run this action without holding the trigger" />
                                                    <Button Grid.Column="4"
                                                            Content="Delete"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Click="Delete_Click"
                                                            ToolTip="Delete this keybind" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddButton"
                                        Grid.Row="2"
                                        Content="Add keybind"
                                        HorizontalAlignment="Left"
                                        Margin="0,14,0,0"
                                        Click="Add_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="RadialSection" Visibility="Collapsed">
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Radial menu" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Shape the ring that appears around your cursor."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Content="Reset section"
                                    Tag="Radial"
                                    Style="{StaticResource QuietButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Click="ResetSection_Click" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="RadialEnabledCheck"
                                          Content="Show the radial menu while the trigger is held"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Checked="Radial_Changed"
                                          Unchecked="Radial_Changed" />
                                <CheckBox x:Name="CursorInteractionCheck"
                                          Content="Use cursor direction to select a wedge"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Checked="Radial_Changed"
                                          Unchecked="Radial_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Outer radius" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="OuterRadiusValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="OuterRadiusSlider"
                                        Minimum="64"
                                        Maximum="140"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Radial_ValueChanged" />
                                <Grid Margin="0,18,0,0">
                                    <TextBlock Text="Inner radius" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="InnerRadiusValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="InnerRadiusSlider"
                                        Minimum="24"
                                        Maximum="120"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Radial_ValueChanged" />
                                <TextBlock Text="The inner radius cannot approach the outer edge too closely."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Wedge assignments" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Choose what each direction commits. Keybind entries follow the bindings in Advanced."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,4,0,14" />
                                <ItemsControl x:Name="RadialSlotList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="105" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource SettingLabelStyle}"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding Choices}"
                                                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                          SelectionChanged="RadialSlot_SelectionChanged"
                                                          VerticalAlignment="Center" />
                                                <CheckBox Grid.Column="2"
                                                          Content="Cycle"
                                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                                          IsChecked="{Binding CycleEnabled, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanCycle}"
                                                          Margin="12,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Checked="RadialSlotCycle_Changed"
                                                          Unchecked="RadialSlotCycle_Changed" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Center action" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="The center is selected when the cursor rests inside the ring."
                                               Style="{StaticResource DescriptionStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="CenterActionCombo"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          SelectionChanged="CenterAction_SelectionChanged" />
                                <CheckBox x:Name="CenterCycleCheck"
                                          Grid.Column="2"
                                          Content="Cycle"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          Checked="CenterCycle_Changed"
                                          Unchecked="CenterCycle_Changed" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PreviewSection" Visibility="Collapsed">
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Preview" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Make the destination frame clear without interrupting your flow."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Content="Reset section"
                                    Tag="Preview"
                                    Style="{StaticResource QuietButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Click="ResetSection_Click" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="PreviewEnabledCheck"
                                          Content="Show the target preview"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Checked="Preview_Changed"
                                          Unchecked="Preview_Changed" />
                                <TextBlock Text="The preview mirrors the frame an action will use."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="52,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Padding" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="PreviewPaddingValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="PreviewPaddingSlider"
                                        Minimum="4"
                                        Maximum="48"
                                        TickFrequency="2"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Preview_ValueChanged" />
                                <Grid Margin="0,18,0,0">
                                    <TextBlock Text="Corner radius" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="PreviewCornerValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="PreviewCornerSlider"
                                        Minimum="4"
                                        Maximum="32"
                                        TickFrequency="2"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Preview_ValueChanged" />
                                <Grid Margin="0,18,0,0">
                                    <TextBlock Text="Border width" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="PreviewBorderWidthValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="PreviewBorderWidthSlider"
                                        Minimum="0"
                                        Maximum="6"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Preview_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Drag snapping" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Preview and commit a half or quarter zone when a title-bar drag reaches a monitor edge."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,4,0,12" />
                                <CheckBox x:Name="DragSnapEnabledCheck"
                                          Content="Snap dragged windows to edges and corners"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Checked="DragSnap_Changed"
                                          Unchecked="DragSnap_Changed" />
                                <CheckBox x:Name="RestorePreDragFrameCheck"
                                          Content="Restore the original frame when a snap is canceled"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Checked="DragSnap_Changed"
                                          Unchecked="DragSnap_Changed" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Snap threshold" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="DragSnapThresholdValue"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="DragSnapThresholdSlider"
                                        Minimum="4"
                                        Maximum="96"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="DragSnap_ValueChanged" />
                                <TextBlock Text="The threshold is measured from the physical monitor edge, so taskbars do not make a zone harder to reach."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Stash and reveal" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Keep windows safely identifiable across a LoopW restart and tune how much of a stashed window remains reachable."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,4,0,12" />
                                <CheckBox x:Name="StashPersistenceCheck"
                                          Content="Persist stashed windows across restart"
                                          Style="{StaticResource ToggleCheckBoxStyle}"
                                          Checked="Stash_Changed"
                                          Unchecked="Stash_Changed" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Edge peek" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="StashEdgePeekValue"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="StashEdgePeekSlider"
                                        Minimum="1"
                                        Maximum="48"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Stash_ValueChanged" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Reveal hit zone" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="StashHitZoneValue"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="StashHitZoneSlider"
                                        Minimum="1"
                                        Maximum="96"
                                        TickFrequency="2"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Stash_ValueChanged" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Reveal delay" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="StashRevealDelayValue"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="StashRevealDelaySlider"
                                        Minimum="0"
                                        Maximum="500"
                                        TickFrequency="20"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="Stash_ValueChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ScreensSection" Visibility="Collapsed">
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Screens &amp; apps" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Choose how LoopW treats monitor boundaries and application targets."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Content="Reset section"
                                    Tag="Screens"
                                    Style="{StaticResource QuietButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Click="ResetSection_Click" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Moving between monitors" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Logical size scales a window with the destination DPI. Pixel size keeps its current physical dimensions."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,4,0,12" />
                                <ComboBox x:Name="MonitorMovePolicyCombo"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="MonitorMovePolicy_SelectionChanged">
                                    <ComboBoxItem Content="Preserve pixel size" Tag="PreservePixels" />
                                    <ComboBoxItem Content="Preserve logical size" Tag="PreserveLogicalSize" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Screen padding" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Keep action frames away from display edges. Global padding is added to each edge, then the per-edge values are added."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,4,0,12" />
                                <Grid>
                                    <TextBlock Text="Global" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="GlobalScreenPaddingValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="GlobalScreenPaddingSlider"
                                        Minimum="0"
                                        Maximum="64"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ScreenPadding_ValueChanged" />
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="Left" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="ScreenPaddingLeftValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="ScreenPaddingLeftSlider"
                                        Minimum="0"
                                        Maximum="64"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ScreenPadding_ValueChanged" />
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="Top" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="ScreenPaddingTopValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="ScreenPaddingTopSlider"
                                        Minimum="0"
                                        Maximum="64"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ScreenPadding_ValueChanged" />
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="Right" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="ScreenPaddingRightValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="ScreenPaddingRightSlider"
                                        Minimum="0"
                                        Maximum="64"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ScreenPadding_ValueChanged" />
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="Bottom" Style="{StaticResource SettingLabelStyle}" />
                                    <TextBlock x:Name="ScreenPaddingBottomValue"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="ScreenPaddingBottomSlider"
                                        Minimum="0"
                                        Maximum="64"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="ScreenPadding_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Excluded applications" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="One executable path per line. Matching apps are ignored by actions, focus, fill, minimize-others, snapping, stash, and IPC."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,4,0,8" />
                                <TextBox x:Name="ExcludedExecutablePathsText"
                                         MinHeight="72"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         LostFocus="Exclusions_LostFocus" />
                                <TextBlock Text="Process names"
                                           Style="{StaticResource SettingLabelStyle}"
                                           Margin="0,14,0,4" />
                                <TextBox x:Name="ExcludedProcessNamesText"
                                         MinHeight="56"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         LostFocus="Exclusions_LostFocus" />
                                <TextBlock Text="Use names such as ExampleApp or ExampleApp.exe. Changes save when the field loses focus."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Appearance" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Choose a calm visual system for LoopW and its window surfaces."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Content="Reset section"
                                    Tag="Appearance"
                                    Style="{StaticResource QuietButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Click="ResetSection_Click" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="App appearance" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Dark is the LoopW standard. Follow Windows when you want the app to match your system."
                                               Style="{StaticResource DescriptionStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="AppearanceModeCombo"
                                          Grid.Column="1"
                                          SelectedValuePath="Tag"
                                          VerticalAlignment="Center"
                                          SelectionChanged="AppearanceMode_SelectionChanged">
                                    <ComboBoxItem Content="LoopW dark" Tag="Dark" />
                                    <ComboBoxItem Content="Follow Windows" Tag="FollowWindows" />
                                    <ComboBoxItem Content="LoopW light" Tag="Light" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Curated styles" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Start with a coherent palette, then open custom colors when you want more control."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,4,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BluePresetButton"
                                            Tag="LoopWBlue"
                                            Style="{StaticResource PresetButtonStyle}"
                                            Click="Preset_Click">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="7" Background="#3D9BFF" Margin="0,0,5,0" />
                                                <Border Width="14" Height="14" CornerRadius="7" Background="#202632" />
                                            </StackPanel>
                                            <TextBlock Text="LoopW blue" Margin="0,9,0,0" />
                                            <TextBlock Text="Focused and familiar" Style="{StaticResource DescriptionStyle}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CobaltPresetButton"
                                            Tag="Cobalt"
                                            Style="{StaticResource PresetButtonStyle}"
                                            Click="Preset_Click">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="7" Background="#6AAEFF" Margin="0,0,5,0" />
                                                <Border Width="14" Height="14" CornerRadius="7" Background="#1B2534" />
                                            </StackPanel>
                                            <TextBlock Text="Cobalt" Margin="0,9,0,0" />
                                            <TextBlock Text="Bright and crisp" Style="{StaticResource DescriptionStyle}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="VioletPresetButton"
                                            Tag="Violet"
                                            Style="{StaticResource PresetButtonStyle}"
                                            Click="Preset_Click">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="7" Background="#B39AFF" Margin="0,0,5,0" />
                                                <Border Width="14" Height="14" CornerRadius="7" Background="#252333" />
                                            </StackPanel>
                                            <TextBlock Text="Violet" Margin="0,9,0,0" />
                                            <TextBlock Text="Soft and expressive" Style="{StaticResource DescriptionStyle}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="CustomThemeExpander"
                                  Header="Advanced custom colors"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  Margin="0,12,0,0"
                                  Padding="4"
                                  IsExpanded="False">
                            <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Use #RRGGBB or #AARRGGBB values."
                                               Style="{StaticResource DescriptionStyle}"
                                               Margin="0,0,0,16" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Accent" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,10" />
                                        <Border x:Name="AccentSwatch" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Margin="0,0,8,10" />
                                        <TextBox x:Name="AccentColorText" Grid.Column="2" Margin="0,0,0,10" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" />
                                        <TextBlock Text="Radial fill" Grid.Row="1" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,10" />
                                        <Border x:Name="SectorFillSwatch" Grid.Row="1" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Margin="0,0,8,10" />
                                        <TextBox x:Name="SectorFillText" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" />
                                        <TextBlock Text="Radial stroke" Grid.Row="2" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,10" />
                                        <Border x:Name="SectorStrokeSwatch" Grid.Row="2" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Margin="0,0,8,10" />
                                        <TextBox x:Name="SectorStrokeText" Grid.Row="2" Grid.Column="2" Margin="0,0,0,10" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" />
                                        <TextBlock Text="Ring fill" Grid.Row="3" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,10" />
                                        <Border x:Name="RingFillSwatch" Grid.Row="3" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Margin="0,0,8,10" />
                                        <TextBox x:Name="RingFillText" Grid.Row="3" Grid.Column="2" Margin="0,0,0,10" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" />
                                        <TextBlock Text="Preview border" Grid.Row="4" Style="{StaticResource SettingLabelStyle}" />
                                        <Border x:Name="PreviewBorderSwatch" Grid.Row="4" Grid.Column="1" Width="16" Height="16" CornerRadius="8" />
                                        <TextBox x:Name="PreviewBorderText" Grid.Row="4" Grid.Column="2" LostFocus="Theme_LostFocus" TextChanged="Theme_TextChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <StackPanel x:Name="AdvancedSection" Visibility="Collapsed">
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Advanced" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Keep recovery tools close at hand."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Content="Reset section"
                                    Tag="Advanced"
                                    Style="{StaticResource QuietButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Click="ResetSection_Click" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Recovery" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Reset every LoopW setting to its original default. This does not affect open windows or tray state."
                                           Style="{StaticResource DescriptionStyle}"
                                           Margin="0,4,0,14" />
                                <Button Content="Reset all settings"
                                        Style="{StaticResource DangerButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="ResetAll_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="2" Grid.Row="1" Margin="0,12,10,0">
            <TextBlock x:Name="StatusText"
                       Text="Saved"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>
    </Grid>
</UserControl>
