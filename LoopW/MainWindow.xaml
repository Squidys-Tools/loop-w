<Window x:Class="LoopW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoopW — Window management, in flow"
        Height="760" Width="1180"
        MinHeight="650" MinWidth="980"
        Background="#0D0F14"
        Foreground="#F5F7FB"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151922" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9199AA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A7F3D0" />
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Background" Value="#1B202B" />
            <Setter Property="BorderBrush" Value="#303747" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F5F7FB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#293342" />
                                <Setter Property="BorderBrush" Value="#A7F3D0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#354556" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="LOOPW" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Window management, in flow." FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="Hold your trigger. Move with intent. Release to commit." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#151922" CornerRadius="18" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="Prototype mode" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="32" BorderBrush="#242B38" BorderThickness="1">
            <Grid>
                <TextBlock Text="ACTIVE WINDOW" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" FontSize="10" FontWeight="Bold" Foreground="#687286" />
                <Border Width="360" Height="230" Background="#202735" BorderBrush="#435065" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="46" Height="46" Background="#354156" CornerRadius="12" HorizontalAlignment="Center">
                            <TextBlock Text="⌘" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="Your active window" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="Preview target" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Grid Width="460" Height="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Fill="#0D0F14" Stroke="#2C3544" StrokeThickness="1" />
                    <Ellipse Width="300" Height="300" Fill="#151B25" Stroke="#273140" StrokeThickness="1" />
                    <Button Style="{StaticResource ActionButton}" Click="Action_Click" Tag="Top" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0">
                        <StackPanel><TextBlock Text="↑" FontSize="28" HorizontalAlignment="Center"/><TextBlock Text="Top half" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Click="Action_Click" Tag="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                        <StackPanel><TextBlock Text="→" FontSize="28" HorizontalAlignment="Center"/><TextBlock Text="Right half" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Click="Action_Click" Tag="Bottom" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                        <StackPanel><TextBlock Text="↓" FontSize="28" HorizontalAlignment="Center"/><TextBlock Text="Bottom half" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButton}" Click="Action_Click" Tag="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
                        <StackPanel><TextBlock Text="←" FontSize="28" HorizontalAlignment="Center"/><TextBlock Text="Left half" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                    </Button>
                    <Border Width="116" Height="116" Background="#A7F3D0" CornerRadius="58" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⌁" FontSize="26" Foreground="#0D1714" HorizontalAlignment="Center" />
                            <TextBlock Text="center" FontSize="12" FontWeight="SemiBold" Foreground="#0D1714" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Selected" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <TextBlock x:Name="SelectedAction" Text="Center" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" />
                <TextBlock x:Name="TargetStatus" Text="  ·  No target captured — press Shift + Space while another app is focused" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="18,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Trigger" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                <Border Background="#202735" CornerRadius="8" Padding="10,6" Margin="10,0,0,0"><TextBlock Text="Shift + Space" FontSize="12" /></Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
