<Window x:Class="LoopW.RadialOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Overlay_Loaded"
        MouseMove="Overlay_MouseMove"
        MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
        KeyDown="Overlay_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SectorFill" Color="#7A6EB9FF" />
        <SolidColorBrush x:Key="SectorStroke" Color="#F06EB9FF" />
    </Window.Resources>
    <Grid x:Name="OverlaySurface" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
        </Grid.RenderTransform>
        <Image x:Name="BackdropImage" Margin="-48" Width="496" Height="496" Stretch="Fill">
            <Image.Effect>
                <BlurEffect Radius="36" />
            </Image.Effect>
        </Image>
        <Path x:Name="Ring" Fill="#B610151F" Stroke="#3D4A5E" StrokeThickness="1.2" />
        <Path x:Name="TopWedge" Opacity="0" Fill="{StaticResource SectorFill}" Stroke="{StaticResource SectorStroke}" StrokeThickness="1.5" />
        <Path x:Name="RightWedge" Opacity="0" Fill="{StaticResource SectorFill}" Stroke="{StaticResource SectorStroke}" StrokeThickness="1.5" />
        <Path x:Name="BottomWedge" Opacity="0" Fill="{StaticResource SectorFill}" Stroke="{StaticResource SectorStroke}" StrokeThickness="1.5" />
        <Path x:Name="LeftWedge" Opacity="0" Fill="{StaticResource SectorFill}" Stroke="{StaticResource SectorStroke}" StrokeThickness="1.5" />
    </Grid>
</Window>
