<Window x:Class="LoopW.PreviewOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="100" Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        IsHitTestVisible="False">
    <Canvas x:Name="Host">
        <Border x:Name="PreviewSurface" Width="100" Height="100" Canvas.Left="0" Canvas.Top="0" Margin="3" CornerRadius="14" BorderBrush="#A7F3D0" BorderThickness="3" Background="#183C5B4D" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
            </Border.RenderTransform>
            <Grid>
                <TextBlock Text="PREVIEW" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" FontSize="10" FontWeight="Bold" Foreground="#D8FFF0" />
                <Border Width="160" Height="34" Background="#CC101A20" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ActionLabel" Text="Right half" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#F5F7FB" />
                </Border>
            </Grid>
        </Border>
    </Canvas>
</Window>
