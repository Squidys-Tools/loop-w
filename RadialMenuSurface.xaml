<UserControl x:Class="LoopW.RadialMenuSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="152"
             Height="152"
             Background="Transparent"
             ClipToBounds="False"
             IsTabStop="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid x:Name="SurfaceRoot" Background="Transparent">
        <Image x:Name="BackdropImage" Stretch="Fill">
            <Image.Effect>
                <BlurEffect Radius="13.68" />
            </Image.Effect>
        </Image>
        <Path x:Name="Ring" Fill="#B61E1E1E" />
        <Path x:Name="CenterHighlight"
              Opacity="0"
              Fill="#7A007AFF"
              IsHitTestVisible="False" />
        <Path x:Name="RightWedge" Opacity="0" Fill="#7A007AFF" Stroke="#F0007AFF" StrokeThickness="1.5" />
        <Path x:Name="BottomRightWedge" Opacity="0" Fill="#7A007AFF" Stroke="#F0007AFF" StrokeThickness="1.5" />
        <Path x:Name="BottomWedge" Opacity="0" Fill="#7A007AFF" Stroke="#F0007AFF" StrokeThickness="1.5" />
        <Path x:Name="BottomLeftWedge" Opacity="0" Fill="#7A007AFF" Stroke="#F0007AFF" StrokeThickness="1.5" />
        <Path x:Name="LeftWedge" Opacity="0" Fill="#7A007AFF" Stroke="#F0007AFF" StrokeThickness="1.5" />
        <Path x:Name="TopLeftWedge" Opacity="0" Fill="#7A007AFF" Stroke="#F0007AFF" StrokeThickness="1.5" />
        <Path x:Name="TopWedge" Opacity="0" Fill="#7A007AFF" Stroke="#F0007AFF" StrokeThickness="1.5" />
        <Path x:Name="TopRightWedge" Opacity="0" Fill="#7A007AFF" Stroke="#F0007AFF" StrokeThickness="1.5" />
    </Grid>
</UserControl>
