<Window x:Class="LoopW.HostBackdropPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="100"
        Height="100"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        Opacity="0">
    <Border x:Name="SurfaceElement"
            Background="#30101827"
            BorderBrush="#B8007AFF"
            BorderThickness="2"
            CornerRadius="14" />
</Window>
