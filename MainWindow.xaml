<Window x:Class="LoopW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoopW — Window management, in flow"
        Height="760" Width="1180"
        MinHeight="650" MinWidth="980"
        Background="#1E1E1E"
        Foreground="#CCCCCC"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
        <SolidColorBrush x:Key="MutedBrush" Color="#858585" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="CapBrush" Color="#333333" />
        <Style x:Key="WedgeStyle" TargetType="Path">
            <Setter Property="Fill" Value="#B61E1E1E" />
            <Setter Property="Stroke" Value="#00000000" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" Value="#7A007AFF" />
                    <Setter Property="Stroke" Value="#F0007AFF" />
                    <Setter Property="StrokeThickness" Value="1.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="LOOPW" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Window management, in flow." FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="Hold your trigger. Move with intent. Release to commit." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#252526" CornerRadius="18" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="Prototype mode" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="32" BorderBrush="#3C3C3C" BorderThickness="1">
            <Grid x:Name="RadialPanel" Width="334.4" Height="334.4" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="RadialPanelScale" ScaleX="0.96" ScaleY="0.96" />
                </Grid.RenderTransform>
                <Canvas Width="334.4" Height="334.4">
                    <Path x:Name="RadialRing" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Fill="#B61E1E1E" />
                    <Path x:Name="TopWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="Top" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="RightWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="Right" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="BottomWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="Bottom" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="LeftWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="Left" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                </Canvas>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" IsHitTestVisible="False">
                    <TextBlock Text="↑" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Top half" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
                    <TextBlock Text="→" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Right half" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" IsHitTestVisible="False">
                    <TextBlock Text="↓" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Bottom half" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                    <TextBlock Text="←" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Left half" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Selected" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <TextBlock x:Name="SelectedAction" Text="Center" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" />
                <TextBlock x:Name="TargetStatus" Text="  ·  No target captured — hold the trigger while another app is focused" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="18,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Trigger" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                <Border x:Name="TriggerCap" Background="#333333" BorderBrush="{StaticResource CapBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="10,0,0,0" Cursor="Hand" ToolTip="Click to rebind the trigger key" MouseLeftButtonUp="TriggerCap_MouseUp">
                    <TextBlock x:Name="TriggerLabel" Text="Caps Lock" FontSize="12" />
                </Border>
                <TextBlock x:Name="RebindHint" Text="rebind" Foreground="{StaticResource AccentBrush}" FontSize="12" Cursor="Hand" Margin="10,0,0,0" VerticalAlignment="Center" MouseLeftButtonUp="RebindHint_MouseUp" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
