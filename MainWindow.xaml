<ui:FluentWindow x:Class="LoopW.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title=""
                 Height="779"
                 Width="1166"
                 MinHeight="760"
                 MinWidth="1100"
                 ResizeMode="CanResize"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowCornerPreference="Round"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 Loaded="Window_Loaded"
                 SourceInitialized="Window_SourceInitialized"
                 Closing="Window_Closing"
                 Closed="Window_Closed"
                 KeyDown="Window_KeyDown">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title=""
                     Icon="{x:Null}"
                     Background="{DynamicResource ApplicationBackgroundBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     ButtonsForeground="{DynamicResource TextFillColorSecondaryBrush}"
                     ButtonsBackground="{DynamicResource ControlFillColorSecondaryBrush}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <ContentControl x:Name="SettingsHost"
                        Grid.Row="1"
                        Background="{DynamicResource ApplicationBackgroundBrush}" />

        <!-- Runtime status elements remain available to the window-management code,
             but the settings surface is the only visible application view. -->
        <Grid x:Name="DashboardRoot" Grid.Row="1" Visibility="Collapsed">
            <TextBlock x:Name="SelectedAction" Text="Center" />
            <TextBlock x:Name="TargetStatus" />
            <TextBlock x:Name="TriggerLabel" />
            <TextBlock x:Name="RebindHint" />
            <Border x:Name="TriggerCap"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" />
        </Grid>
    </Grid>
</ui:FluentWindow>
