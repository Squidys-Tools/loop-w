<Window x:Class="LoopW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LoopW Settings"
        Height="700" Width="920"
        MinHeight="620" MinWidth="860"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="#F0F4FA"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Closed="Window_Closed"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="14"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
        <SolidColorBrush x:Key="MutedBrush" Color="#858585" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="CapBrush" Color="#333333" />
        <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#101216" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#151A23" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#2A3444" />
        <SolidColorBrush x:Key="ChromeTextBrush" Color="#AAB6C8" />
        <SolidColorBrush x:Key="ChromeMutedBrush" Color="#6F7B8A" />
        <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#222C3A" />
        <SolidColorBrush x:Key="WindowCloseHoverBrush" Color="#C94F63" />

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="2,5,0,5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ControlChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlChrome" Property="Background" Value="{DynamicResource WindowControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ControlChrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ControlChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ControlChrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WedgeStyle" TargetType="Path">
            <Setter Property="Fill" Value="#B61E1E1E" />
            <Setter Property="Stroke" Value="#00000000" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SectorFillBrush}" />
                    <Setter Property="Stroke" Value="{DynamicResource SectorStrokeBrush}" />
                    <Setter Property="StrokeThickness" Value="1.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="WindowFrame"
                Margin="8"
                Background="{DynamicResource WindowSurfaceBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      Background="{DynamicResource TitleBarBrush}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Border Width="26"
                                Height="26"
                                CornerRadius="8"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="L"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White" />
                        </Border>
                        <TextBlock Text="LoopW"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Settings"
                                   Margin="8,1,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource ChromeMutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button x:Name="MinimizeButton"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <Path Data="M 5,14 L 15,14"
                                  Stroke="{DynamicResource ChromeTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="MaximizeButton"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize">
                            <Path Data="M 5,5 H 15 V 15 H 5 Z"
                                  Stroke="{DynamicResource ChromeTextBrush}"
                                  StrokeThickness="1.5"
                                  Fill="Transparent" />
                        </Button>
                        <Button x:Name="CloseButton"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource CloseWindowButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Close">
                            <Path Data="M 6,6 L 14,14 M 14,6 L 6,14"
                                  Stroke="{DynamicResource ChromeTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
        <Grid x:Name="DashboardRoot" Margin="42" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="LOOPW" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Window management, in flow." FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="Hold your trigger. Move with intent. Release to commit." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#252526" CornerRadius="18" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="Prototype mode" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="32" BorderBrush="#3C3C3C" BorderThickness="1">
            <Grid x:Name="RadialPanel" Width="334.4" Height="334.4" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="RadialPanelScale" ScaleX="0.96" ScaleY="0.96" />
                </Grid.RenderTransform>
                <Canvas x:Name="RadialPanelCanvas" Width="334.4" Height="334.4">
                    <Path x:Name="RadialRing" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Fill="#B61E1E1E" />
                    <Path x:Name="RightWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="RightHalf" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="BottomRightWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="BottomRightQuarter" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="BottomWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="BottomHalf" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="BottomLeftWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="BottomLeftQuarter" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="LeftWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="LeftHalf" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="TopLeftWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="TopLeftQuarter" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="TopWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="TopHalf" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                    <Path x:Name="TopRightWedge" Width="182.4" Height="182.4" Canvas.Left="76" Canvas.Top="76" Tag="TopRightQuarter" Style="{StaticResource WedgeStyle}" MouseLeftButtonUp="Wedge_MouseUp" />
                </Canvas>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" IsHitTestVisible="False">
                    <TextBlock Text="↑" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Top half" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
                    <TextBlock Text="→" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Right half" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" IsHitTestVisible="False">
                    <TextBlock Text="↓" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Bottom half" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                    <TextBlock Text="←" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Left half" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Text="Top-left quarter" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,84,0,0" IsHitTestVisible="False" />
                <TextBlock Text="Top-right quarter" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,84,58,0" IsHitTestVisible="False" />
                <TextBlock Text="Bottom-left quarter" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="58,0,0,84" IsHitTestVisible="False" />
                <TextBlock Text="Bottom-right quarter" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,58,84" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Selected" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <TextBlock x:Name="SelectedAction" Text="Center" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" />
                <TextBlock x:Name="TargetStatus" Text="  ·  No target captured — hold the trigger while another app is focused" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="18,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Trigger" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                <Border x:Name="TriggerCap" Background="#333333" BorderBrush="{StaticResource CapBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="10,0,0,0" Cursor="Hand" ToolTip="Click to rebind the trigger key" MouseLeftButtonUp="TriggerCap_MouseUp">
                    <TextBlock x:Name="TriggerLabel" Text="Caps Lock" FontSize="12" />
                </Border>
                <TextBlock x:Name="RebindHint" Text="rebind" Foreground="{DynamicResource AccentBrush}" FontSize="12" Cursor="Hand" Margin="10,0,0,0" VerticalAlignment="Center" MouseLeftButtonUp="RebindHint_MouseUp" />
                <TextBlock Text="settings" Foreground="{DynamicResource AccentBrush}" FontSize="12" Cursor="Hand" Margin="18,0,0,0" VerticalAlignment="Center" MouseLeftButtonUp="Settings_MouseUp" />
            </StackPanel>
        </Grid>
        </Grid>
        <ContentControl x:Name="SettingsHost" Background="{DynamicResource WindowSurfaceBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
