<Window x:Class="LoopW.PreviewOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="100" Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        IsHitTestVisible="False">
    <Canvas x:Name="Host">
        <Border x:Name="PreviewSurface" Width="100" Height="100" Canvas.Left="0" Canvas.Top="0" CornerRadius="14" Background="Transparent" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
            </Border.RenderTransform>
            <Grid>
                <Image x:Name="BackdropImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image.Effect>
                        <BlurEffect Radius="18" />
                    </Image.Effect>
                </Image>
                <Border Background="#1AFFFFFF" CornerRadius="11" />
            </Grid>
        </Border>
    </Canvas>
</Window>
